# --- Zernio ---
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Apify (ilham hesaplarını çekmek için) ---
APIFY_TOKEN=

# --- Telegram ---
# @BotFather'dan alınan token
TELEGRAM_BOT_TOKEN=
# Botu başlatınca /start yazın; bot size chat id'nizi söyler, buraya girin
TELEGRAM_CHAT_ID=

# --- Panel (python -m igbot.dashboard) ---
# 127.0.0.1 = yalnızca bu bilgisayardan erişim. Ağdan erişim için 0.0.0.0 (şifre yine zorunlu).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5001
# Boş bırakılırsa ilk açılışta rastgele üretilip buraya yazılır.
DASHBOARD_PASSWORD=
DASHBOARD_SECRET_KEY=
